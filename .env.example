# Register an authorized CatBuy OAuth integration. These values never enter browser code.
CATBUY_OAUTH_AUTHORIZE_URL=
CATBUY_OAUTH_TOKEN_URL=
CATBUY_API_BASE_URL=
CATBUY_CLIENT_ID=
CATBUY_CLIENT_SECRET=
CATBUY_REDIRECT_URI=http://localhost:3000/api/catbuy/callback
CATBUY_SCOPES=
# Use the exact paths specified by CatBuy or your approved integration. {id} is substituted server-side.
CATBUY_SEARCH_PATH=
CATBUY_PRODUCT_PATH=
CATBUY_TOP_UP_PATH=
CATBUY_PURCHASE_PATH=
# Generate with: openssl rand -base64 32. Used only by the server to encrypt linked OAuth tokens.
TOKEN_ENCRYPTION_KEY=
MOGBUY_SERVICE_FEE_BPS=500
MOGBUY_SERVICE_FEE_FLAT_CENTS=0
PORT=3000
